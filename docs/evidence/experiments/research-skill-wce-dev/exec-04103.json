t trusts this deck over the policy fails the Evidence grounding rubric.\\\\r\\\\n\\\\u003C/slide_3\\\\u003E\\\\r\\\\n\\\\u003Cslide_4\\\\u003E\\\\r\\\\n\\\\r\\\\n## \\\\u003Cspan style=\\\\u0022color:#1F4E79\\\\u0022\\\\u003EWarranty cost by product family (INR lakh)\\\\u003C/span\\\\u003E\\\\r\\\\n\\\\r\\\\n\\\\u003Cchart\\\\u003E\\\\r\\\\n\\\\u003CsourceData\\\\u003E\\\\r\\\\n\\\\u003Ctable\\\\u003E \\\\u003Ctr\\\\u003E \\\\u003Ctd\\\\u003E\\\\u003C/td\\\\u003E \\\\u003Ctd\\\\u003EFY25 Q3\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003EFY25 Q4\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003EFY26 Q1\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003EFY26 Q2\\\\u003C/td\\\\u003E \\\\u003C/tr\\\\u003E\\\\u003Ctr\\\\u003E \\\\u003Ctd\\\\u003E4000-series chiller\\\\u003C/td\\\\u003E \\\\u003Ctd\\\\u003E182\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003E174\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003E196\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003E211\\\\u003C/td\\\\u003E \\\\u003C/tr\\\\u003E\\\\u003Ctr\\\\u003E \\\\u003Ctd\\\\u003E2200-series compressor\\\\u003C/td\\\\u003E \\\\u003Ctd\\\\u003E96\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003E101\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003E94\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003E88\\\\u003C/td\\\\u003E \\\\u003C/tr\\\\u003E \\\\u003C/table\\\\u003E\\\\r\\\\n\\\\u003C/sourceData\\\\u003E\\\\r\\\\n\\\\u003C/chart\\\\u003E\\\\r\\\\n\\\\u003C/slide_4\\\\u003E\\\\r\\\\n\\\\u003Cslide_5\\\\u003E\\\\r\\\\n\\\\r\\\\n## \\\\u003Cspan style=\\\\u0022color:#1F4E79\\\\u0022\\\\u003ETop failure modes \\\\u2014 4000-series\\\\u003C/span\\\\u003E\\\\r\\\\n\\\\r\\\\n\\\\u003Ctable\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Component**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Claims**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Share**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Trend**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nHydraulic circuit\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n214\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n38%\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nRising\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nCompressor\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n147\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n26%\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nStable\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nControl system\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n88\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n16%\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nFalling\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nStructural / cooling\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n61\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n11%\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nStable\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nOther\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n52\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n9%\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nStable\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003C/table\\\\u003E\\\\r\\\\n\\\\r\\\\n\\\\u003C/slide_5\\\\u003E\\\\r\\\\n\\\\u003Cslide_6\\\\u003E\\\\