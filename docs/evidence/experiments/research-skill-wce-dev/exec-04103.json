*\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n2026-01-15\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Product family**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n4000-series industrial chiller\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Serial range**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nCIE-4000-CH-01200 to CIE-4000-CH-01850 inclusive\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Status**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nCurrent\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003C/table\\\\u003E\\\\r\\\\n\\\\r\\\\n\\\\r\\\\n## Purpose\\\\r\\\\n  \\\\r\\\\nElevated failure rates have been observed on the hydraulic circuit and compressor of affected units. Coverage is extended as set out below.\\\\r\\\\n\\\\r\\\\n## Effect on warranty\\\\r\\\\n  \\\\r\\\\nFor assets within the serial range named above, coverage of the hydraulic circuit and compressor is extended to 36 months from the date of commissioning, or 8,000 running hours, whichever occurs first.  \\\\r\\\\nThis bulletin names a serial range and therefore takes precedence over the regional addendum and the Global Warranty Policy, in accordance with clause 1.4 of that policy.\\\\r\\\\n\\\\r\\\\n## Note on the service system index\\\\r\\\\n  \\\\r\\\\nThe applicability index held in the service claim system is maintained for reporting and may lag this document. Where the index and this bulletin disagree on the serial range, this bulletin governs, in accordance with clause 1.4 of the Global Warranty Policy.\\\\r\\\\n\\\\r\\\\n## Claim handling\\\\r\\\\n  \\\\r\\\\nClaims adjudicated under this bulletin are recorded against funding code TSB with the reference TSB-C-0051.\\u0022,\\u0022RelevanceScore\\u0022:0.75360936}]},{\\u0022WebUrl\\u0022:\\u0022https://microsoftapc.sharepoint.com/teams/ContosoFieldService/Warranty Operations/02-Bulletins/TSB-C-0038 Control board firmware revision - advisory.docx\\u0022,\\u0022ResourceMetadata\\u0022:{\\u0022Title\\u0022:\\u0022TSB-C-0038 Control board firmware revision - advisory\\u0022,\\u0022Author\\u0022:\\u0022python-docx;Srikantan Sankaran\\u0022,\\u0022Filename\\u0022:\\u0022TSB-C-0038 Control board firmware revision - advisory.docx\\u0022,\\u0022URL\\u0022:\\u0022https://microsoftapc.sharepoint.com/teams/ContosoFieldService/Warranty Operations/02-Bulletins/TSB-C-0038 Control board firmware revision - advisory.docx\\u0022},\\u0022Extracts\\u0022:[{\\u0022Text\\u0022:\\u0022  \\\\r\\\\n**\\\\u003Cspan style=\\\\u0022color:#606060\\\\u0022\\\\u003ECONTOSO INDUSTRIAL\\\\u003C/span\\\\u003E**\\\\r\\\\n# Technical Service Bulletin TSB-C-0038  \\\\r\\\\n_Control board firmware revision - advisory_\\\\r\\\\n\\\\u003Ctable\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Bulletin reference**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\nTSB-C-0038\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Effective from**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n2025-08-20\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Product family**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n4000-series industrial chiller\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Serial range**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nAll serials in the named family\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Status**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nCurrent\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003C/table\\\\u003E\\\\r\\\\n\\\\r\\\\n\\\\r\\\\n## Purpose\\\\r\\\\n  \\\\r\\\\nA firmware revision is available for the control board. Apply at the next scheduled service visit. This bulletin is advisory and does not vary the warranty position of any asset.\\\\r\\\\n\\\\r\\\\n## Claim handling\\\\r\\\\n  \\\\r\\\\nNo change to claim handling arises from this bulletin.\\u0022,\\u0022RelevanceScore\\u0022:0.7794454}]},{\\u0022WebUrl\\u0022:\\u0022https://microsoftapc.sharepoint.com/teams/ContosoFieldService/Warranty Operations/05-Reviews/FY26-Q2-Warranty-Review.pptx\\u0022,\\u0022ResourceMetadata\\u0022:{\\u0022Title\\u0022:\\u0022FY26-Q2-Warranty-Review\\u0022,\\u0022Author\\u0022:\\u0022Srikantan Sankaran\\u0022,\\u0022Filename\\u0022:\\u0022FY26-Q2-Warranty-Review.pptx\\u0022,\\u0022URL\\u0022:\\u0022https://microsoftapc.sharepoint.com/teams/ContosoFieldService/Warranty Operations/05-Reviews/FY26-Q2-Warranty-Review.pptx\\u0022},\\u0022Extracts\\u0022:[{\\u0022Text\\u0022:\\u0022\\\\u003Cslide_1\\\\u003E\\\\r\\\\n\\\\r\\\\n## \\\\u003Cspan style=\\\\u0022color:#1F4E79\\\\u0022\\\\u003EWarranty Review \\\\u2014 FY26 Q2\\\\u003C/span\\\\u003E\\\\r\\\\n  \\\\r\\\\nContoso Industrial \\\\u00B7 Warranty Operations \\\\u00B7 published 14 October 2025\\\\r\\\\n\\\\u003C/slide_1\\\\u003E\\\\r\\\\n\\\\u003Cslide_2\\\\u003E\\\\r\\\\n\\\\r\\\\n## \\\\u003Cspan style=\\\\u0022color:#1F4E79\\\\u0022\\\\u003EHeadlines\\\\u003C/span\\\\u003E\\\\r\\\\n- Warranty cost at 2.8% of revenue, down 0.3 points on FY25 Q4\\\\r\\\\n- Claim volume up 11% year on year, driven by the 4000-series installed base\\\\r\\\\n- Average settlement time 8.4 working days against a 10-day target\\\\r\\\\n- India remains the largest region by claim volume\\\\r\\\\n\\\\u003C/slide_2\\\\u003E\\\\r\\\\n\\\\u003Cslide_3\\\\u003E\\\\r\\\\n\\\\r\\\\n## \\\\u003Cspan style=\\\\u0022color:#1F4E79\\\\u0022\\\\u003ECoverage at a glance\\\\u003C/span\\\\u003E\\\\r\\\\n- Standard coverage: 24 months from commissioning, or 6,000 running hours\\\\r\\\\n- Applies across all product families and all regions\\\\r\\\\n- Labour reimbursed at flat-rate allowance\\\\r\\\\n- Parts reimbursed at territory list price\\\\r\\\\n- Goodwill available at manager discretion for near-miss cases\\\\r\\\\n- TRAP 6. This slide is the stale summary. \\\\u0027Applies across all product families and all regions\\\\u0027 was never true of India (18 months under ADD-IN-2.1) and is wrong for any asset covered by TSB-C-0051 or TSB-P-0112. \\\\u0027Goodwill at manager discretion\\\\u0027 contradicts policy 7.1, which requires recorded authority at tier. A model that trusts this deck over the policy fails the Evidence grounding rubric.\\\\r\\\\n\\\\u003C/slide_3\\\\u003E\\\\r\\\\n\\\\u003Cslide_4\\\\u003E\\\\r\\\\n\\\\r\\\\n## \\\\u003Cspan style=\\\\u0022color:#1F4E79\\\\u0022\\\\u003EWarranty cost by product family (INR lakh)\\\\u003C/span\\\\u003E\\\\r\\\\n\\\\r\\\\n\\\\u003Cchart\\\\u003E\\\\r\\\\n\\\\u003CsourceData\\\\u003E\\\\r\\\\n\\\\u003Ctable\\\\u003E \\\\u003Ctr\\\\u003E \\\\u003Ctd\\\\u003E\\\\u003C/td\\\\u003E \\\\u003Ctd\\\\u003EFY25 Q3\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003EFY25 Q4\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003EFY26 Q1\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003EFY26 Q2\\\\u003C/td\\\\u003E \\\\u003C/tr\\\\u003E\\\\u003Ctr\\\\u003E \\\\u003Ctd\\\\u003E4000-series chiller\\\\u003C/td\\\\u003E \\\\u003Ctd\\\\u003E182\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003E174\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003E196\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003E211\\\\u003C/td\\\\u003E \\\\u003C/tr\\\\u003E\\\\u003Ctr\\\\u003E \\\\u003Ctd\\\\u003E2200-series compressor\\\\u003C/td\\\\u003E \\\\u003Ctd\\\\u003E96\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003E101\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003E94\\\\u003C/td\\\\u003E\\\\u003Ctd\\\\u003E88\\\\u003C/td\\\\u003E \\\\u003C/tr\\\\u003E \\\\u003C/table\\\\u003E\\\\r\\\\n\\\\u003C/sourceData\\\\u003E\\\\r\\\\n\\\\u003C/chart\\\\u003E\\\\r\\\\n\\\\u003C/slide_4\\\\u003E\\\\r\\\\n\\\\u003Cslide_5\\\\u003E\\\\r\\\\n\\\\r\\\\n## \\\\u003Cspan style=\\\\u0022color:#1F4E79\\\\u0022\\\\u003ETop failure modes \\\\u2014 4000-series\\\\u003C/span\\\\u003E\\\\r\\\\n\\\\r\\\\n\\\\u003Ctable\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Component**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Claims**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Share**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Trend**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nHydraulic circuit\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n214\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n38%\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nRising\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nCompressor\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n147\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n26%\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nStable\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nControl system\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n88\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n16%\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \