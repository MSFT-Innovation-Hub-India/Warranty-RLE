r\\\\n- Goodwill approvals given in channels are not being recorded against claims\\\\r\\\\n- Authority must be recorded in the claim system \\\\u2014 policy 7.1\\\\r\\\\n- Commissioning records missing for a small number of assets\\\\r\\\\n\\\\u003C/slide_6\\\\u003E\\\\r\\\\n\\u0022,\\u0022RelevanceScore\\u0022:0.7113694}]},{\\u0022WebUrl\\u0022:\\u0022https://microsoftapc.sharepoint.com/teams/ContosoFieldService/Warranty Operations/06-ClaimEvidence/C-2026-04176 Inspection Report CIE-4000-CH-02100.docx\\u0022,\\u0022ResourceMetadata\\u0022:{\\u0022Title\\u0022:\\u0022C-2026-04176 Inspection Report CIE-4000-CH-02100\\u0022,\\u0022Author\\u0022:\\u0022python-docx;Srikantan Sankaran\\u0022,\\u0022Filename\\u0022:\\u0022C-2026-04176 Inspection Report CIE-4000-CH-02100.docx\\u0022,\\u0022URL\\u0022:\\u0022https://microsoftapc.sharepoint.com/teams/ContosoFieldService/Warranty Operations/06-ClaimEvidence/C-2026-04176 Inspection Report CIE-4000-CH-02100.docx\\u0022},\\u0022Extracts\\u0022:[{\\u0022Text\\u0022:\\u0022  \\\\r\\\\n**\\\\u003Cspan style=\\\\u0022color:#606060\\\\u0022\\\\u003ECONTOSO INDUSTRIAL\\\\u003C/span\\\\u003E**\\\\r\\\\n# Field Inspection Report  \\\\r\\\\n_Claim C-2026-04176_\\\\r\\\\n\\\\u003Ctable\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Claim reference**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\nC-2026-04176\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Serial number**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nCIE-4000-CH-02100\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Product**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n4000-series industrial chiller\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Service partner**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nFabrikam Service Partners\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Date of repair**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n2026-06-18\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Operation code**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nHYD-PUMP-RR\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Running hours at repair**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n3,000\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003C/table\\\\u003E\\\\r\\\\n\\\\r\\\\n\\\\r\\\\n## Findings\\\\r\\\\n  \\\\r\\\\nHydraulic pump seized under load. Drive coupling intact. No external impact damage. Pump removed and replaced.\\\\r\\\\n\\\\r\\\\n## Parts fitted\\\\r\\\\n\\\\r\\\\n\\\\u003Ctable\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Part number**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Description**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Quantity**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nP-44120-A\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nHydraulic pump assembly, rev A\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n1\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003C/table\\\\u003E\\\\r\\\\n\\\\r\\\\n\\\\r\\\\n## Labour\\\\r\\\\n  \\\\r\\\\n5.5 hours claimed against operation HYD-PUMP-RR.  \\\\r\\\\n_Inspected by: Sunil Bhat, Field Engineer, Fabrikam Service Partners_\\u0022,\\u0022RelevanceScore\\u0022:0.72983813}]},{\\u0022WebUrl\\u0022:\\u0022https://microsoftapc.sharepoint.com/teams/ContosoFieldService/Warranty Operations/01-Policy/ADD-IN-2.1 Regional Addendum - India v2.1.docx\\u0022,\\u0022ResourceMetadata\\u0022:{\\u0022Title\\u0022:\\u0022ADD-IN-2.1 Regional Addendum - India v2.1\\u0022,\\u0022Author\\u0022:\\u0022python-docx;Srikantan Sankaran\\u0022,\\u0022Filename\\u0022:\\u0022ADD-IN-2.1 Regional Addendum - India v2.1.docx\\u0022,\\u0022URL\\u0022:\\u0022https://microsoftapc.sharepoint.com/teams/ContosoFieldService/Warranty Operations/01-Policy/ADD-IN-2.1 Regional Addendum - India v2.1.docx\\u0022},\\u0022Extracts\\u0022:[{\\u0022Text\\u0022:\\u0022  \\\\r\\\\n**\\\\u003Cspan style=\\\\u0022color:#606060\\\\u0022\\\\u003ECONTOSO INDUSTRIAL\\\\u003C/span\\\\u003E**\\\\r\\\\n# Regional Addendum - India  \\\\r\\\\n_Version 2.1 \\\\u2014 effective 2025-04-01_\\\\r\\\\n\\\\u003Ctable\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Reference**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\nADD-IN-2.1\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Region**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nIndia\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Currency**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nINR\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Effective from**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n2025-04-01\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Read with**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nPOL-WAR-4.2 Contoso Industrial Global Warranty Policy\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003C/table\\\\u003E\\\\r\\\\n\\\\r\\\\n\\\\r\\\\n## Scope\\\\r\\\\n  \\\\r\\\\nThis addendum varies the Global Warranty Policy for equipment installed in India. Where this addendum is silent, the Global Warranty Policy applies without variation. Where a Technical Service Bulletin names the serial range of an asset, clause 1.4 of the Global Warranty Policy governs the order of precedence.\\\\r\\\\n\\\\r\\\\n### A1  Varied coverage period\\\\r\\\\n  \\\\r\\\\nFor assets installed in India, the standard coverage period at clause 2.1 of the Global Warranty Policy is varied to eighteen (18) months from the date of commissioning, or five thousand (5,000) running hours, whichever occurs first.\\\\r\\\\n\\\\r\\\\n### A3  Coastal and monsoon exclusion\\\\r\\\\n  \\\\r\\\\nCorrosion damage at a coastal installation arising between 1 June and 30 September is excluded, save where a Technical Service Bulletin provides otherwise.\\\\r\\\\n\\\\r\\\\n## Summary of varied terms\\\\r\\\\n\\\\r\\\\n\\\\u003Ctable\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Term**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Global policy**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**India**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nCoverage period\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n24 months\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n18 months\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nRunning-hours limit\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n6,000 h\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n5,000 h\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003C/table\\\\u003E\\\\r\\\\n\\\\r\\\\n\\u0022,\\u0022RelevanceScore\\u0022:0.7748669}]},{\\u0022WebUrl\\u0022:\\u0022https://microsoftapc.sharepoint.com/teams/ContosoFieldService/Warranty Operations/06-ClaimEvidence/C-2026-04148 Inspection Report CIE-4000-CH-01440.docx\\u0022,\\u0022ResourceMetadata\\u0022:{\\u0022Title\\u0022:\\u0022C-2026-04148 Inspection Report CIE-4000-CH-01440\\u0022,\\u0022Author\\u0022:\\u0022python-docx;Srikantan Sankaran\\u0022,\\u0022Filename\\u0022:\\u0022C-2026-04148 Inspection Report CIE-4000-CH-01440.docx\\u0022,\\u0022URL\\u0022:\\u0022https://microsoftapc.sharepoint.com/teams/ContosoFieldService/Warranty Operations/06-ClaimEvidence/C-2026-04148 Inspection Report CIE-4000-CH-01440.docx\\u0022},\\u0022Extracts\\u0022:[{\\u0022Text\\u0022:\\u0022  \\\\r\\\\n**\\\\u003Cspan style=\\\\u0022color:#606060\\\\u0022\\\\u003ECONTOSO INDUSTRIAL\\\\u003C/span\\\\u003E**\\\\r\\\\n# Field Inspection Report  \\\\r\\\\n_Claim C-2026-04148_\\\\r\\\\n\\\\u003Ctable\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\n**Claim reference**\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003Cth\\\\u003E  \\\\r\\\\nC-2026-04148\\\\r\\\\n\\\\u003C/th\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Serial number**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\nCIE-4000-CH-01440\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n**Product**\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\\\\n4000-series industrial chiller\\\\r\\\\n\\\\u003C/td\\\\u003E\\\\r\\\\n\\\\u003C/tr\\\\u003E\\\\r\\\\n\\\\u003Ctr\\\\u003E\\\\r\\\\n\\\\u003Ctd\\\\u003E  \\\\r\